# Local values that work with `docker compose -f compose.dev.yaml up -d` and `pnpm start:dev`.
# Copy this file to .env for local work; .env is never committed.
# When 5432 or 4222 is taken on the host, start the stack with DEV_POSTGRES_PORT / DEV_NATS_PORT set
# and use the same ports below.

# Runtime environment (development, test, production) and logs. LOG_PRETTY=true asks for the
# pino-pretty development transport; it is refused with NODE_ENV=production.
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# Port of the internal HTTP API.
PORT=3011

# This service's own PostgreSQL database, with the two roles of compose.dev.yaml. The service runs
# as the application role; `pnpm migration:run` applies the migrations as the migrator role.
DATABASE_URL=postgres://organization_app:organization_app@localhost:5432/organization
MIGRATION_DATABASE_URL=postgres://organization_migrator:organization_migrator@localhost:5432/organization
# Total database transaction attempts on retryable errors. Set to 1 to disable retries.
DATABASE_TRANSACTION_MAX_ATTEMPTS=3

# NATS JetStream broker and the user of this service, read by @cadenway/nest-messaging. The broker of
# compose.dev.yaml refuses a connection without a user, as the brokers of cadenway-ops do; the
# `organization` user receives its replies under `_INBOX.organization`, the only inbox prefix it may
# subscribe to, and the service refuses to start while the EVENTS stream is missing (`nats-streams`
# creates it).
NATS_URL=nats://localhost:4222
NATS_USER=organization
NATS_PASSWORD=organization

# Internal token: the `aud` this service accepts and the public keys of the backends allowed to call
# it, as one line of JSON. The key below is a placeholder whose private half was discarded: the
# service starts, and every call to a route other than /health/* answers 401. To call the service,
# print a key pair with `docker compose run --rm internal-token-keys --print` in cadenway-ops/compose,
# put its API_GATEWAY_INTERNAL_TOKEN_PUBLIC_JWKS value in place of the placeholder, and sign tokens
# with its API_GATEWAY_INTERNAL_TOKEN_PRIVATE_JWK (docs/development.md). Never commit a private key.
INTERNAL_TOKEN_AUDIENCE=organization-service
INTERNAL_TOKEN_TRUSTED_ISSUERS='{"api-gateway":[{"kty":"OKP","crv":"Ed25519","x":"MVZQc5h6AXxnMpaBTaYw5kI-yWWawl6zp8Srhuf5NK0","kid":"local-placeholder"}]}'

# Optional Search issuer fallback, using one or more comma-separated public Ed25519 JWK objects.
SEARCH_SERVICE_INTERNAL_TOKEN_PUBLIC_JWKS=
# Optional Identity issuer fallback for live membership reads and the organization ID export.
IDENTITY_SERVICE_INTERNAL_TOKEN_PUBLIC_JWKS=
# Optional public issuer fallbacks for Task and Realtime live membership reads.
TASK_SERVICE_INTERNAL_TOKEN_PUBLIC_JWKS=
REALTIME_GATEWAY_INTERNAL_TOKEN_PUBLIC_JWKS=
# Stable Organization Search export cursor key shared by its replicas, 32 bytes in base64url.
SEARCH_PROJECTION_CURSOR_SECRET=
# Optional public issuer fallbacks for the Billing and quota notification authority.
BILLING_SERVICE_INTERNAL_TOKEN_PUBLIC_JWKS=
NOTIFICATION_SERVICE_INTERNAL_TOKEN_PUBLIC_JWKS=
# Stable Organization Billing authority cursor key, 32 bytes in base64url, shared by replicas.
BILLING_AUTHORITY_CURSOR_SECRET=
# Enable after Gateway handles the quota refusal.
ORGANIZATION_SEAT_QUOTA_ENABLED=false
# Enable after the broker grants Organization its Billing durable.
ORGANIZATION_SEAT_ENTITLEMENT_EVENTS_ENABLED=false

# OpenTelemetry collector, OTLP over HTTP. Unset: spans are created, nothing leaves the process.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
